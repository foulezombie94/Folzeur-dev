{
  "name": "folzeur-rag-native",
  "version": "1.0.0",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "name": "folzeur_rag_native",
    "triples": {
      "defaults": true,
      "additional": [
        "x86_64-pc-windows-msvc",
        "aarch64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "x86_64-apple-darwin",
        "aarch64-apple-darwin"
      ]
    }
  },
  "engines": {
    "node": ">= 18"
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "artifacts": "napi artifacts",
    "benchmark:retrieval": "node benchmarks/retrieval-gate.mjs",
    "benchmark:scale": "node benchmarks/scale.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.16.0"
  }
}
